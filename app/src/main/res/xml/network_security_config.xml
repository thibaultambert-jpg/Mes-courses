<?xml version="1.0" encoding="utf-8"?>
<!-- Application personnelle : l'hôte MCP/SearXNG est joint en HTTP via le réseau privé Tailscale (100.x.y.z). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
