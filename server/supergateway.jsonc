// Passerelle MCP de l'hôte maison : expose les MCP drive (stdio) en Streamable HTTP
// sur un seul port, protégés par un jeton. Lancement : ./start.sh (ou start.ps1 sous Windows).
//
//   http://<ip-tailscale>:8811/carrefour/mcp
//   http://<ip-tailscale>:8811/leclerc/mcp
//
// La liste `tools` limite ce que l'application peut voir : les outils de commande,
// de créneau et de PAIEMENT ne sont jamais exposés.
{
  "port": 8811,
  "host": "0.0.0.0",
  "outputTransport": "streamableHttp",
  // Les MCP drive pilotent un navigateur : une session = un processus, gardé 30 min.
  "stateful": true,
  "sessionTimeout": 1800000,
  "apiKey": "${MES_COURSES_TOKEN}",
  "healthEndpoint": "/healthz",
  "mcpServers": {
    "carrefour": {
      // https://github.com/maximeallanic/CarrefourDriveMCP (Node ≥ 20)
      "command": "npx",
      "args": ["-y", "github:maximeallanic/CarrefourDriveMCP"],
      "env": { "CARREFOUR_DATA_DIR": "${MES_COURSES_DATA:-./data}/carrefour" },
      "tools": [
        "search_products",
        "get_products_by_gtins",
        "get_cart",
        "add_item_to_cart",
        "add_item_to_cart_by_ean",
        "get_favorite_store",
        "get_frequent_purchases",
        "carrefour_session_status"
      ]
    },
    "leclerc": {
      // https://github.com/maxime-desmarchelier/fr-grocery-mcp (Node ≥ 26) — gère aussi Super U
      "command": "npx",
      "args": ["-y", "fr-grocery-mcp@0.1.1"],
      "env": {
        "FR_GROCERY_CONFIG": "${MES_COURSES_CONFIG:-./fr-grocery.json}",
        "FR_GROCERY_STATE_DIR": "${MES_COURSES_DATA:-./data}/fr-grocery"
      },
      "tools": [
        "list_stores",
        "search_products",
        "get_product",
        "get_cart",
        "add_to_cart",
        "set_quantity",
        "get_order_conditions",
        "find_stores",
        "set_store"
      ]
    },
    "auchan": {
      // Aucun MCP Auchan France n'existe à ce jour : voir README (phase 2).
      "disabled": true,
      "command": "node",
      "args": ["./auchan-mcp/index.mjs"]
    }
  }
}
